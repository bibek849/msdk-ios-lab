{
  "name": "@msdk-ios-lab/agent-inbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
