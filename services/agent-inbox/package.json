    "db:local": "wrangler d1 migrations apply msdk-ios-lab-inbox-pilot --local"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "wrangler": "4.156.2"
  }
}
